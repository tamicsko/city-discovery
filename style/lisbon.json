{
  "version": 8,
  "name": "Lisboa Downtown — pictorial",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet",
      "attribution": "<a href=\"https://openfreemap.org\">OpenFreeMap</a> © <a href=\"https://www.openmaptiles.org/\">OpenMapTiles</a> · Adat: <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a>"
    },
    "walk": {
      "type": "geojson",
      "data": { "type": "FeatureCollection", "features": [] }
    }
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "light": {
    "anchor": "viewport",
    "color": "#ffffff",
    "intensity": 0.45,
    "position": [1.4, 200, 40]
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#ffffff" }
    },

    {
      "id": "landuse-residential",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["match", ["get", "class"], ["residential", "suburb", "neighbourhood"], true, false],
      "paint": { "fill-color": "#faf8f4" }
    },
    {
      "id": "landuse-institution",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["match", ["get", "class"], ["hospital", "school", "university", "cemetery"], true, false],
      "paint": { "fill-color": "#f2f1ea" }
    },
    {
      "id": "landcover-green",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["match", ["get", "class"], ["wood", "grass", "farmland"], true, false],
      "paint": { "fill-color": "#d5e4ad" }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": { "fill-color": "#d5e4ad" }
    },
    {
      "id": "park-outline",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": { "line-color": "#bed195", "line-width": 1 }
    },

    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "filter": ["!=", ["get", "brunnel"], "tunnel"],
      "paint": { "fill-color": "#a9cee3" }
    },
    {
      "id": "water-shore",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "water",
      "filter": ["!=", ["get", "brunnel"], "tunnel"],
      "paint": { "line-color": "#8fbcd6", "line-width": 1.4 }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#a9cee3",
        "line-width": ["interpolate", ["linear"], ["zoom"], 13, 1, 18, 5]
      }
    },

    {
      "id": "pier",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["==", ["get", "class"], "pier"],
      "paint": { "fill-color": "#efece5" }
    },

    {
      "id": "street-minor-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 14,
      "filter": ["match", ["get", "class"], ["minor", "service", "track"], true, false],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#e6e3dc",
        "line-width": ["interpolate", ["exponential", 1.4], ["zoom"], 14, 3, 18, 16, 19, 26]
      }
    },
    {
      "id": "street-minor",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 14,
      "filter": ["match", ["get", "class"], ["minor", "service", "track"], true, false],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#ffffff",
        "line-width": ["interpolate", ["exponential", 1.4], ["zoom"], 14, 1.6, 18, 12, 19, 21]
      }
    },

    {
      "id": "street-pedestrian",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 14,
      "filter": ["match", ["get", "class"], ["path", "pedestrian"], true, false],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#f3ece0",
        "line-width": ["interpolate", ["exponential", 1.4], ["zoom"], 14, 1.4, 18, 9, 19, 15]
      }
    },

    {
      "id": "street-major-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["match", ["get", "class"], ["motorway", "trunk", "primary", "secondary", "tertiary"], true, false],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#d9b52c",
        "line-width": ["interpolate", ["exponential", 1.4], ["zoom"], 13, 4, 16, 12, 19, 34]
      }
    },
    {
      "id": "street-major",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["match", ["get", "class"], ["motorway", "trunk", "primary", "secondary", "tertiary"], true, false],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#f7d84b",
        "line-width": ["interpolate", ["exponential", 1.4], ["zoom"], 13, 2.6, 16, 9, 19, 28]
      }
    },

    {
      "id": "tram-route",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 13,
      "filter": ["all",
        ["==", ["get", "class"], "transit"],
        ["match", ["get", "brunnel"], ["tunnel"], false, true]
      ],
      "layout": { "line-cap": "butt", "line-join": "round" },
      "paint": {
        "line-color": "#d9b52c",
        "line-width": ["interpolate", ["linear"], ["zoom"], 13, 1.6, 19, 5],
        "line-dasharray": [3, 2]
      }
    },
    {
      "id": "rail",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 14,
      "filter": ["==", ["get", "class"], "rail"],
      "paint": {
        "line-color": "#c9c5bd",
        "line-width": ["interpolate", ["linear"], ["zoom"], 14, 1.2, 19, 3.5]
      }
    },

    {
      "id": "walk-casing",
      "type": "line",
      "source": "walk",
      "layout": { "line-cap": "round", "line-join": "round", "visibility": "none" },
      "paint": { "line-color": "#ffffff", "line-width": 11, "line-opacity": 0.9 }
    },
    {
      "id": "walk-line",
      "type": "line",
      "source": "walk",
      "layout": { "line-cap": "round", "line-join": "round", "visibility": "none" },
      "paint": { "line-color": "#1a73e8", "line-width": 6, "line-opacity": 0.95 }
    },

    {
      "id": "building-flat",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 13,
      "maxzoom": 15,
      "paint": {
        "fill-color": "#dbd8d2",
        "fill-outline-color": "#c6c2ba"
      }
    },
    {
      "id": "building-3d",
      "type": "fill-extrusion",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 15,
      "paint": {
        "fill-extrusion-color": [
          "interpolate", ["linear"], ["get", "render_height"],
          0, "#e2dfd9",
          12, "#dbd8d2",
          30, "#d2cec7",
          60, "#c9c5bd"
        ],
        "fill-extrusion-height": ["get", "render_height"],
        "fill-extrusion-base": ["get", "render_min_height"],
        "fill-extrusion-opacity": 0.95,
        "fill-extrusion-vertical-gradient": true
      }
    },

    {
      "id": "street-label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 15,
      "filter": ["match", ["get", "class"], ["motorway", "trunk", "primary", "secondary", "tertiary", "minor", "pedestrian", "path"], true, false],
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 15, 9, 19, 13],
        "text-letter-spacing": 0.02,
        "text-max-angle": 32,
        "text-padding": 2,
        "symbol-spacing": 260
      },
      "paint": {
        "text-color": "#5a5751",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.4
      }
    },
    {
      "id": "water-label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "water_name",
      "layout": {
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Italic"],
        "text-size": 14,
        "text-letter-spacing": 0.14,
        "symbol-placement": "line"
      },
      "paint": {
        "text-color": "#3f7fa3",
        "text-halo-color": "#d9ecf6",
        "text-halo-width": 1.2
      }
    }
  ]
}
