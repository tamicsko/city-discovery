{
  "version": 8,
  "name": "Lisboa Downtown — pictorial",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet",
      "attribution": "<a href=\"https://openfreemap.org\">OpenFreeMap</a> © <a href=\"https://www.openmaptiles.org/\">OpenMapTiles</a> · Adat: <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a>"
    }
  },
  "glyphs": "fonts/{fontstack}/{range}.pbf",
  "light": {
    "anchor": "viewport",
    "color": "#ffffff",
    "intensity": 0.45,
    "position": [
      1.4,
      200,
      40
    ]
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#fdfaf2"
      }
    },
    {
      "id": "landuse-residential",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": [
        "match",
        [
          "get",
          "class"
        ],
        [
          "residential",
          "suburb",
          "neighbourhood"
        ],
        true,
        false
      ],
      "paint": {
        "fill-color": "#faf6ea"
      }
    },
    {
      "id": "landuse-institution",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": [
        "match",
        [
          "get",
          "class"
        ],
        [
          "hospital",
          "school",
          "university",
          "cemetery"
        ],
        true,
        false
      ],
      "paint": {
        "fill-color": "#f3efe1"
      }
    },
    {
      "id": "landcover-green",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": [
        "match",
        [
          "get",
          "class"
        ],
        [
          "wood",
          "grass",
          "farmland"
        ],
        true,
        false
      ],
      "paint": {
        "fill-color": "#d8e5b2"
      }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": {
        "fill-color": "#d8e5b2"
      }
    },
    {
      "id": "park-outline",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": {
        "line-color": "#b9cc8c",
        "line-width": 1
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "filter": [
        "!=",
        [
          "get",
          "brunnel"
        ],
        "tunnel"
      ],
      "paint": {
        "fill-color": "#a9cee3"
      }
    },
    {
      "id": "water-shore",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "water",
      "filter": [
        "!=",
        [
          "get",
          "brunnel"
        ],
        "tunnel"
      ],
      "paint": {
        "line-color": "#7aa9c6",
        "line-width": 1.4
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#a9cee3",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          13,
          1,
          18,
          5
        ]
      }
    },
    {
      "id": "pier",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "==",
        [
          "get",
          "class"
        ],
        "pier"
      ],
      "paint": {
        "fill-color": "#efe9db"
      }
    },
    {
      "id": "street-minor-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 14,
      "filter": [
        "match",
        [
          "get",
          "class"
        ],
        [
          "minor",
          "service",
          "track"
        ],
        true,
        false
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#ded7c6",
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.4
          ],
          [
            "zoom"
          ],
          14,
          3,
          18,
          16,
          19,
          26
        ]
      }
    },
    {
      "id": "street-minor",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 14,
      "filter": [
        "match",
        [
          "get",
          "class"
        ],
        [
          "minor",
          "service",
          "track"
        ],
        true,
        false
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#fffdf7",
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.4
          ],
          [
            "zoom"
          ],
          14,
          1.6,
          18,
          12,
          19,
          21
        ]
      }
    },
    {
      "id": "street-pedestrian",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 14,
      "filter": [
        "match",
        [
          "get",
          "class"
        ],
        [
          "path",
          "pedestrian"
        ],
        true,
        false
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#f0e7d4",
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.4
          ],
          [
            "zoom"
          ],
          14,
          1.4,
          18,
          9,
          19,
          15
        ]
      }
    },
    {
      "id": "street-major-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "match",
        [
          "get",
          "class"
        ],
        [
          "motorway",
          "trunk",
          "primary",
          "secondary",
          "tertiary"
        ],
        true,
        false
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#d9b52c",
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.4
          ],
          [
            "zoom"
          ],
          13,
          4,
          16,
          12,
          19,
          34
        ]
      }
    },
    {
      "id": "street-major",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "match",
        [
          "get",
          "class"
        ],
        [
          "motorway",
          "trunk",
          "primary",
          "secondary",
          "tertiary"
        ],
        true,
        false
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#f7d84b",
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.4
          ],
          [
            "zoom"
          ],
          13,
          2.6,
          16,
          9,
          19,
          28
        ]
      }
    },
    {
      "id": "tram-route",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 13,
      "filter": [
        "all",
        [
          "==",
          [
            "get",
            "class"
          ],
          "transit"
        ],
        [
          "match",
          [
            "get",
            "brunnel"
          ],
          [
            "tunnel"
          ],
          false,
          true
        ]
      ],
      "layout": {
        "line-cap": "butt",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#d9b52c",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          13,
          1.6,
          19,
          5
        ],
        "line-dasharray": [
          3,
          2
        ]
      }
    },
    {
      "id": "rail",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 14,
      "filter": [
        "==",
        [
          "get",
          "class"
        ],
        "rail"
      ],
      "paint": {
        "line-color": "#cac3b3",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          14,
          1.2,
          19,
          3.5
        ]
      }
    },
    {
      "id": "street-label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 15.5,
      "filter": [
        "match",
        [
          "get",
          "class"
        ],
        [
          "motorway",
          "trunk",
          "primary",
          "secondary",
          "tertiary",
          "pedestrian"
        ],
        true,
        false
      ],
      "layout": {
        "symbol-placement": "line",
        "text-field": [
          "coalesce",
          [
            "get",
            "name:latin"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Patrick Hand Regular"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          15,
          12,
          19,
          17
        ],
        "text-letter-spacing": 0.0,
        "text-max-angle": 32,
        "text-padding": 2,
        "symbol-spacing": 420
      },
      "paint": {
        "text-color": "#5b5245",
        "text-halo-color": "#fdfaf2",
        "text-halo-width": 1.8
      }
    },
    {
      "id": "water-label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "water_name",
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:latin"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Patrick Hand Regular"
        ],
        "text-size": 20,
        "text-letter-spacing": 0.2,
        "symbol-placement": "line"
      },
      "paint": {
        "text-color": "#3d7c9e",
        "text-halo-color": "#d9ecf6",
        "text-halo-width": 1.2
      }
    }
  ]
}